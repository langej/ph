{
    "name": "@langej/ph",
    "version": "0.1.1",
    "type": "module",
    "browser": "dist/ph.js",
    "module": "dist/ph.esm.js",
    "license": "MIT",
    "devDependencies": {
        "@types/bun": "latest",
        "prettier": "^3.5.3",
        "@playwright/test": "^1.57.0"
    },
    "dependencies": {
        "@preact/signals-core": "^1.12.1"
    },
    "scripts": {
        "build": "rm -rf ./dist && bun ./build/build.ts",
        "test": "bun run build && bun x playwright test",
        "test:ui": "bun run test --ui",
        "format": "prettier --write ./src/**/*.ts",
        "test-server": "bun x http-server -p 3111",
        "test:container": "docker build --tag ph-playwright-tests . && docker run --rm ph-playwright-tests"
    }
}
